# 复制成 .env 后填入真实值（.env 已在 .gitignore 中，不会被提交）

# --- 对话模型：DeepSeek（OpenAI 兼容协议）---
# 模型名用 deepseek-flash；想要更强推理可换 deepseek-v4-pro（价格约 4.5 倍）
KB_CHAT_BASE_URL=https://api.deepseek.com/v1
KB_CHAT_API_KEY=sk-你的deepseek-key
KB_CHAT_MODEL=deepseek-flash
# DeepSeek 默认开启思考模式（强度 high），问答会明显变慢变贵，默认关掉
KB_CHAT_THINKING=disabled

# --- 向量模型：DeepSeek 不提供 embedding 接口，需要单独一家 ---
# 方案 A：硅基流动（有免费额度，bge-m3 中文效果好）
KB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBED_API_KEY=sk-你的siliconflow-key
KB_EMBED_MODEL=BAAI/bge-m3
KB_EMBED_DIMENSION=1024
# 硅基流动不认 dimensions 参数，保持 false；换成 OpenAI 的 text-embedding-3 时改 true
KB_EMBED_SEND_DIMENSIONS=false
# 分批向量化的批大小，文档大时可以调小
KB_EMBED_BATCH_SIZE=16
# 第二周做重排时可以用这个，同样免费
# KB_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 方案 B：阿里云百炼（把上面三行换成这些）
# KB_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KB_EMBED_MODEL=text-embedding-v4
# KB_EMBED_DIMENSION=1024

# --- 数据库 ---
KB_DB_HOST=localhost
KB_DB_PORT=5432
KB_DB_NAME=kb
KB_DB_USER=kb
KB_DB_PASSWORD=kb

# --- 访问口令 ---
# 留空 = 不启用（本地开发）。部署到公网时必须设置成一串随机字符，
# 否则任何人扫到端口都能调用接口，白嫖你的模型额度。
KB_ACCESS_TOKEN=
# 管理员口令：后台写操作（改成员、传图片、管文档）的凭证。
# 生成方式：openssl rand -hex 16
KB_ADMIN_TOKEN=
