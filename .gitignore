uploads/
knowledge/uploads/

# ============================================================
# 私有资料
#   private/ 里放真实成员信息、内部文档、部署脚本等，
#   只留在自己机器上，不进公开仓库。
# ============================================================
private/

# 面向具体机构的数据更新脚本（与真实的库绑定，不适合公开）
deploy/update-lab-content.sql

# ============================================================
# 个人/内部文档
#   技术文档（02、03、10、20、21）会随仓库发布；
#   日程、面经、简历、站点初始内容这些只留在本地。
# ============================================================
docs/00-*.md
docs/01-*.md
docs/04-*.md
docs/05-*.md
docs/06-*.md
docs/11-*.md

