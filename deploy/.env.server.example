# 服务器上的密钥文件。复制成 .env 放在 deploy/ 目录下，填好真实值。
# 权限建议 chmod 600 .env，避免同机器其他用户读到你的 API key。

# --- 访问口令（公网必填）---
# 用随机字符串，例如：openssl rand -hex 16
KB_ACCESS_TOKEN=

# --- 管理员口令（上线必填）---
# 后台所有写操作的凭证：改成员、传照片、管文档、跑评测。
# 生成方式： openssl rand -hex 16
KB_ADMIN_TOKEN=

# --- 端口 ---
KB_APP_PORT=8080

# --- JVM 堆大小 ---
# 独占机器（内存 4G 以上）可以不填，用默认的 -Xmx1g。
# 共享机器或 2G 内存的小机器，调小一点，避免和同机其他服务抢内存。
JAVA_OPTS=-Xms128m -Xmx512m

# --- Docker 镜像源 ---
# 国内服务器直连 Docker Hub 会超时，默认走 daocloud。
# 如果哪天这个源不可用了，换成别的可用源，或者在能直连的机器上留空。
KB_DOCKER_REGISTRY=docker.m.daocloud.io

# --- 对话模型：DeepSeek ---
KB_CHAT_BASE_URL=https://api.deepseek.com/v1
KB_CHAT_API_KEY=
KB_CHAT_MODEL=deepseek-flash
KB_CHAT_THINKING=disabled

# --- 向量模型：硅基流动 ---
KB_EMBED_BASE_URL=https://api.siliconflow.cn/v1
KB_EMBED_API_KEY=
KB_EMBED_MODEL=BAAI/bge-m3
KB_EMBED_DIMENSION=1024
KB_EMBED_BATCH_SIZE=16

# --- 数据库（跑在容器里，不要用弱密码）---
KB_DB_NAME=kb
KB_DB_USER=kb
KB_DB_PASSWORD=

# --- Redis（缓存问题向量 + 按 IP 限流）---
# 生成方式： openssl rand -hex 16
KB_REDIS_PASSWORD=

# --- 限流参数（可选，默认每 IP 每分钟 20 次提问）---
KB_RATE_LIMIT_ENABLED=true
KB_RATE_LIMIT_WINDOW=60
KB_RATE_LIMIT_MAX=20
